extends: default

rules:
  document-start: disable
  comments-indentation: false
  line-length:
    max: 120
    level: warning
  comments:
    min-spaces-from-content: 1
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    allowed-values: ["true", "false", "on", "off"]
    check-keys: false
